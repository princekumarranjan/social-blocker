{
  "manifest_version": 3,
  "name": "Wapas",
  "version": "1.1.0",
  "description": "Counts your reels and screen time, then covers the screen with a meme when you cross your limit.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wapas"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.youtube.com/*",
        "*://*.snapchat.com/*",
        "*://*.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://social-blocker.vercel.app/*"
    ]
  }
}
